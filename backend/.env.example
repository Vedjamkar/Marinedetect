# Copy to .env and adjust as needed. All defaults below match config.py.

# --- models ---
YOLO_MODEL_PATH=weights/yolo/best.pt
UNET_MODEL_PATH=weights/unet/unet.pth
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
UNET_INPUT_SIZE=256
UNET_NUM_CLASSES=3          # 0=background, 1=highlight, 2=shadow
UNET_MASK_THRESHOLD=0.5     # only used when UNET_NUM_CLASSES=1

# --- pipeline ---
ROI_PAD_RATIO=0.25
SHADOW_DIRECTION=none        # down|up|right|left|none
ALLOW_CLASSICAL_FALLBACK=false
SHADOW_THRESHOLD_K=1.0

# --- runtime ---
DEVICE=auto
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- limits ---
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=80000000
OUTPUT_RETENTION_HOURS=24
