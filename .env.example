# Copy to .env and edit. All values are optional; the defaults are in backend/config.py.

# --- which detector to load -------------------------------------------------
# Two trained detectors ship with this project. Point at whichever you want.
#
#   best.pt            seabed objects  - classes: ship, aircraft, human
#                      trained on SCTD.  mAP@0.5 0.794
#
#   debris_crabpot.pt  marine debris   - class: Crab-Pot (derelict fishing gear)
#                      trained on the crab-pot side-scan set.  mAP@0.5 0.465,
#                      and that is a PARTIAL run stopped at epoch 12 of 25.
#                      See CREDITS.md - this one carries CC-BY-SA share-alike.
#
# Both detectors run on every frame; each detection records which found it.
# Remove one from this list if you want only the other.
YOLO_MODEL_PATHS=weights/yolo/best.pt,weights/yolo/debris_crabpot.pt

UNET_MODEL_PATH=weights/unet/unet.pth

# --- detection thresholds ---------------------------------------------------
YOLO_CONFIDENCE=0.40
YOLO_IOU=0.45

# --- shadow / geometry ------------------------------------------------------
ROI_PAD_RATIO=0.25
SHADOW_DIRECTION=none
SHADOW_THRESHOLD_K=1.0

# --- runtime ----------------------------------------------------------------
DEVICE=auto
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
